include_rules

DEPS = newplus/libnewplus.so
RPATH_NEWPLUS=\$ORIGIN/newplus
LINK_FLAGS += -Lnewplus -lnewplus -Wl,-rpath,$(RPATH_NEWPLUS)

NODE_VERSION = 6.9.0

NODE_GYP_FLAGS = -DNODE_GYP_MODULE_NAME=newplus -DUSING_UV_SHARED=1 -DUSING_V8_SHARED=1 -DV8_DEPRECATION_WARNINGS=1 -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 -DBUILDING_NODE_EXTENSION -Ivendor/nodejs/include/node

NODE_CXX_FLAGS = $(CXXFLAGS) -std=c++20 -fno-exceptions

# =====================================

: foreach *.c |> !cc |> c/%B.o

: foreach *.cpp |> !cxx |> cpp/%B.o

# ===================================== exe linked to shared lib

# c
: c/*.o | $(DEPS) |> !cc_exe |> c_hello

# c static (compiles C source directly, no dynamic linking)
: hello.c newplus/plus.c |> $(CC) -o %o $(OPT_FLAG) %f |> c_static_hello

# cpp
: cpp/*.o | $(DEPS) |> !cxx_exe |> cpp_hello

# csharp (use mcs if csc doesn't work)
: hello.cs | $(DEPS) |> csc /out:%o %f |> csharp_hello.exe

# v
: hello.v | $(DEPS) |> v %f -o %o |> v_hello

# go
: hello.go | $(DEPS) |> go build -o %o %f |> go_hello

# rust
: hello.rs | $(DEPS) |> rustc -C opt-level=2 -C link-args="$(LINK_FLAGS)" -o %o %f |> rust_hello

# dart
: foreach dart/*.cpp |> $(CXX) -c %f -o %o $(CXXFLAGS) -DDART_SHARED_LIB -Ivendor/dart/include -I. |> dart/%B.o

: dart/*.o newplus/_.a |> $(CXX) -o %o -shared $(OPT_FLAG) %f |> dart/libnewplus_extension.so

# d
: hello.d |> dmd -betterC -c %f -odd -O -release |> d/%B.o

: d/*.o | $(DEPS) |> dmd -betterC %f -of%o -L-Lnewplus -L-lnewplus -L-rpath=$(RPATH_NEWPLUS) -O -release |> d_hello

# d ldc2
: hello.d |> ldc2 -betterC -c %f -odd_ldc2 -O -release |> d_ldc2/%B.o

: d_ldc2/*.o | $(DEPS) |> ldc2 -betterC %f -of%o -L-Lnewplus -L-lnewplus -L-rpath=$(RPATH_NEWPLUS) -O -release |> d_ldc2_hello

# haskell
: hello.hs | $(DEPS) |> ghc -O2 -Lnewplus -lnewplus -optl-Wl,-rpath,$(RPATH_NEWPLUS) -o ghc_hello %f |> ghc_hello hello.hi hello.o

# node
: foreach node/*.cpp |> $(CXX) -c %f -o %o $(NODE_CXX_FLAGS) $(NODE_GYP_FLAGS) -I. |> node/%B.o

: node/*.o newplus/_.a |> $(CXX) -o %o -shared $(OPT_FLAG) -Wl,-soname=%o %f |> newplus.node

# nim
: hello.nim $(DEPS) |> tmp=\$(mktemp -d); trap 'rm -rf "$tmp"' EXIT; nim c -d:release --parallelBuild:1 --nimcache:"$tmp/nimcache" -o:%o --passL:"$(LINK_FLAGS)" hello.nim |> nim_hello

# zig
: build.zig hello.zig newplus/plus.c newplus/plus.h |> tmp=\$(mktemp -d); trap 'rm -rf "$tmp"' EXIT; zig build -Doptimize=ReleaseFast --cache-dir "$tmp/cache" --global-cache-dir "$tmp/global-cache" |> zig-out/zig_hello/zig_hello

# OCaml bytecode and native executables share compiler intermediates, so build them in one rule.
: ocaml/mlplus.c ocaml/plus_ml.ml newplus/plus.o |> cd ocaml && ocamlopt -o test.nat ../newplus/plus.o mlplus.c plus_ml.ml && ocamlc -o test.bc -custom ../newplus/plus.o mlplus.c plus_ml.ml |> ocaml/test.nat ocaml/test.bc ocaml/mlplus.o ocaml/plus_ml.cmi ocaml/plus_ml.cmx ocaml/plus_ml.o ocaml/plus_ml.cmo

# Elixir NIF
: elixir/plus_one.c newplus/plus.c |> ERLANG_PATH=\$(erl -eval 'io:format("~s", [lists:concat([code:root_dir(), "/erts-", erlang:system_info(version), "/include"])])' -s init stop -noshell); $(CC) -std=c11 $(OPT_FLAG) -Wall -Wextra -Wno-unused-parameter -I"$ERLANG_PATH" -shared -fPIC %f -o %o |> elixir/plus_one.so

# Jolt AOT binary. Build in a temporary tree so Jolt's auxiliary files stay outside Tup's outputs.
: jolt/ffi_overhead/jolt.jolt | $(DEPS) |> root=\$(pwd); out="$root/%o"; tmp=\$(mktemp -d); trap 'rm -rf "$tmp"' EXIT; ln -s "$root/jolt" "$tmp/jolt"; ln -s "$root/newplus" "$tmp/newplus"; cd "$tmp"; jolt -Sdeps '{:paths ["jolt"]}' build -m ffi-overhead.jolt -o jolt_hello --opt --direct-link; cp jolt_hello "$out" |> jolt_hello

# Clojure AOT jars. Temporary trees keep compiler caches and variable class outputs away from Tup.
: clojure_panama/deps.edn clojure_panama/hello.clj | $(DEPS) |> root=\$(pwd); out="$root/%o"; tmp=\$(mktemp -d); trap 'rm -rf "$tmp"' EXIT; mkdir -p "$tmp/clojure_panama/classes" "$tmp/clojure_panama/clojure_panama"; ln -s "$root/clojure_panama/deps.edn" "$tmp/clojure_panama/deps.edn"; ln -s "$root/clojure_panama/hello.clj" "$tmp/clojure_panama/clojure_panama/hello.clj"; ln -s "$root/newplus" "$tmp/newplus"; cd "$tmp/clojure_panama"; clojure -J--enable-native-access=ALL-UNNAMED -M -e '(binding [*compile-path* "classes"] (compile (quote clojure-panama.hello)))'; jar --create --file "$out" -C classes . |> clojure_panama/hello.jar

: clojure_coffi/deps.edn clojure_coffi/ffi_overhead/coffi.clj | $(DEPS) |> root=\$(pwd); out="$root/%o"; tmp=\$(mktemp -d); trap 'rm -rf "$tmp"' EXIT; mkdir -p "$tmp/clojure_coffi/classes"; ln -s "$root/clojure_coffi/deps.edn" "$tmp/clojure_coffi/deps.edn"; ln -s "$root/clojure_coffi/ffi_overhead" "$tmp/clojure_coffi/ffi_overhead"; ln -s "$root/newplus" "$tmp/newplus"; cd "$tmp/clojure_coffi"; clojure -J--enable-native-access=ALL-UNNAMED -M -e '(binding [*compile-path* "classes"] (compile (quote ffi-overhead.coffi)))'; jar --create --file "$out" -C classes . |> clojure_coffi/hello.jar

