# =====================================

# Use vendor JDKs from flake.nix shellHook
JDK21_HOME = $(PROJECT_DIR)/vendor/openjdk21
JDK25_HOME = $(PROJECT_DIR)/vendor/openjdk25

# Panama FFI requires Java 21+ (preview in 21, standard in 22+)
: Hello.java |> $(JDK21_HOME)/bin/javac --enable-preview --release 21 -d .. %f |> %B.class
: Hello.java |> $(JDK25_HOME)/bin/javac -d ../jhello_panama25 %f |> ../jhello_panama25/jhello_panama/%B.class