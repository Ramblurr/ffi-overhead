include_rules

# =====================================

# Use vendor JDKs from flake.nix shellHook
JDK8_HOME = $(PROJECT_DIR)/vendor/openjdk8
JDK21_HOME = $(PROJECT_DIR)/vendor/openjdk21
JDK24_HOME = $(PROJECT_DIR)/vendor/openjdk24

CFLAGS += -I$(JDK8_HOME)/include -I$(JDK8_HOME)/include/linux
CFLAGS21 += -I$(JDK21_HOME)/include -I$(JDK21_HOME)/include/linux
CFLAGS24 += -I$(JDK24_HOME)/include -I$(JDK24_HOME)/include/linux

N1 = newplus
DIR1 = $(PROJECT_DIR)/$(N1)

: foreach *.c |> !cc |>

# ===================================== shared lib containing all the deps

: *.o |> !ar |>
: *.a $(PROJECT_DIR)/$(N1)/_.a |> !cc_shared |>

: Hello.java |> $(JDK8_HOME)/bin/javac -d .. %f |> %B.class
: Hello.java |> $(JDK21_HOME)/bin/javac -d ../jhello21 %f |> ../jhello21/jhello/%B.class
: Hello.java |> $(JDK24_HOME)/bin/javac -d ../jhello24 %f |> ../jhello24/jhello/%B.class

